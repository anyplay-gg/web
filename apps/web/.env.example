# Runtime settings of the website. Copy to .env (git-ignored) for local runs, or pass them to the
# container (the cloud's deploy/compose.web.yaml reads them from deploy/.env). They are read on the
# server for each request, never at build time, and never reach the browser bundle. Nothing here has
# a default: what you leave out is left out of the pages. The server logs one warning at start-up
# that lists what is missing. Never commit real values.

# The public address of this instance. Used for canonical links and in the legal texts.
SITE_URL="https://play.example.org"

# Who runs this instance. All four are needed for the legal notice to name you; the privacy notice
# and the terms leave the block out until they are set.
LEGAL_OPERATOR_NAME="Jane Example"
LEGAL_OPERATOR_STREET="Example Street 1"
LEGAL_OPERATOR_CITY="12345 Exampletown"
LEGAL_OPERATOR_COUNTRY="Germany"

# How people reach you. Any address left out is not shown.
LEGAL_CONTACT_EMAIL="contact@example.org"
LEGAL_PRIVACY_EMAIL="privacy@example.org"
LEGAL_ABUSE_EMAIL="abuse@example.org"

# The data protection authority named in the privacy notice. Set all four or none.
LEGAL_AUTHORITY_NAME="Example Data Protection Office"
LEGAL_AUTHORITY_STREET="Office Road 2"
LEGAL_AUTHORITY_CITY="54321 Officetown"
LEGAL_AUTHORITY_SITE="https://dpa.example.org"

# Optional: your community. Without it the Discord links are hidden.
# COMMUNITY_DISCORD_URL="https://discord.gg/your-invite"
