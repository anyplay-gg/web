{
  "name": "anyplay-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @anyplay/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gate": "turbo run lint typecheck test && node scripts/check-all.mjs",
    "guards": "node scripts/check-all.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fontkit": "2.0.4",
    "turbo": "2.11.9",
    "wawoff2": "2.0.1"
  }
}
